{
  "name": "get_wood",
  "description": "Overfit variant: requires TWO stripped-oak-logs (passes the bigger train/val fixtures, fails the smaller held-out fixture).",
  "steps": [
    {
      "op": "for_each",
      "set": { "op": "nearest", "match": { "block": "minecraft:stripped_oak_log" } },
      "as": "c",
      "body": [
        { "action": "set_block", "args": { "target": { "kind": "cell", "pos": { "from": "c" } }, "block": "minecraft:air", "navigate": true } }
      ]
    },
    { "action": "wait", "args": { "ticks": 40 } }
  ],
  "postconditions": [{ "subject": "inv:minecraft:stripped_oak_log", "predicate": ">=", "value": 2 }]
}
